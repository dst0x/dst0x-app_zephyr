/dts-v1/;
#include <st/f4/stm32f412Xe.dtsi>
#include <st/f4/stm32f412r(e-g)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/clock/stm32f410_clock.h>

/ {
	model = "WeAct Studio STM32F412 Core Board";
	compatible = "weact,stm32f412-core", "st,stm32f412";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
	};

	leds {
		compatible = "gpio-leds";

		user_led: led {
			gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		led0 = &user_led;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&pll {
	div-m = <8>;
	mul-n = <192>;
	div-p = <2>;
	div-q = <4>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(96)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&dma2 {
	status = "okay";
};

&usart6 {
	pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	dmas = <&dma2 6 5 STM32_DMA_PERIPH_TX 0>,
	       <&dma2 1 5 STM32_DMA_PERIPH_RX 0>;
	dma-names = "tx", "rx";
	status = "okay";
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";

	modbus0: modbus0 {
		compatible = "zephyr,modbus-serial";
		status = "okay";
	};
};

&sdmmc1 {
	pinctrl-0 = <&sdio_d0_pc8 &sdio_d1_pc9 &sdio_d2_pc10 &sdio_d3_pc11
		     &sdio_ck_pc12 &sdio_cmd_pd2>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB2, 11)>,
		 <&rcc STM32_SRC_PLL_Q SDIO_SEL(0)>;
	disk-name = "SD";
	bus-width = <4>;
	clk-div = <4>;
	status = "okay";
};
